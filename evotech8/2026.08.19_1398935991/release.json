  },
  "entries": [
    {
      "id": "backfill-20260819-flex-transiente",
      "tipo": "novo",
      "publico": "usuario",
      "titulo": "Compensação transiente para flex fuel",
      "descricao": "O enriquecimento de aceleração e o filme de parede (tau e beta) ganham um multiplicador em tabela 8x8 por temperatura e percentual de etanol, para corrigir a hesitação em tip-in com etanol. Fica neutro sem sensor de etanol, com a função desligada ou com a tabela zerada.",
      "mapa": {
        "impacto": "campos_novos",
        "campos": [
          "flexFuelTransientComp"
        ],
        "acao": ""
      }
    },
    {
      "id": "backfill-20260819-journal",
      "tipo": "novo",
      "publico": "usuario",
      "titulo": "Gravação em tempo real: o aprendido e os ajustes não se perdem",
      "descricao": "As correções aprendidas (LTFT, etanol do sensor virtual) e as edições feitas com o motor ligado agora são gravadas em um journal na flash, e sobrevivem a desligar o carro antes de um Burn. Burn com o motor ligado grava só as diferenças; com o motor parado continua gravando tudo. A verificação de gravação, as tentativas e a redundância foram reforçadas.",
      "mapa": {
        "impacto": "nenhum",
        "campos": [],
        "acao": ""
      }
    },
    {
