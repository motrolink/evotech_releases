    {
      "id": "backfill-20260819-malha-fechada-v3",
      "tipo": "melhoria",
      "publico": "usuario",
      "titulo": "STFT e LTFT unificados em um modelo único",
      "descricao": "A correção de combustível em malha fechada usa uma grade de mistura (rotação x carga) em lugar das antigas regiões, com um modelo de transporte do escape para aplicar o lambda lido ao evento de combustão correto. A saída do DFCO passou a ser suave: o combustível não zera na entrada (piso de 10%) e volta em rampa, e há retardo de ignição padrão na saída.",
      "mapa": {
        "impacto": "revisar",
        "campos": [
          "dfcoRetardDeg",
          "dfcoRetardRampInTime"
        ],
        "acao": "Revise a calibração de STFT, LTFT e do retardo/rampa do DFCO: o comportamento da correção mudou."
      }
    },
    {
      "id": "backfill-20260819-persistencia-unificada",
      "tipo": "melhoria",
      "publico": "usuario",
      "titulo": "LTFT, etanol aprendido e odômetro viraram parte da configuração",
      "descricao": "Os trims do LTFT, o etanol estimado e o odômetro passaram a ser campos normais da configuração, no mesmo Burn e CRC dos demais. A página extra de LTFT do TunerStudio foi removida.",
      "mapa": {
        "impacto": "nenhum",
        "campos": [],
        "acao": ""
      }
    },
    {
      "id": "backfill-20260819-tracao",
      "tipo": "melhoria",
      "publico": "usuario",
      "titulo": "Controle de tração refeito: detecção por três modos",
      "descricao": "O controle de tração antigo (tabelas de corte, retardo e borboleta) foi removido. O novo módulo detecta patinação por aceleração da rotação (sem sensor de roda), por relação rotação/cardã ou por dois sensores de velocidade. Nesta versão ele só detecta, sem cortar ignição ou borboleta.",
      "mapa": {
        "impacto": "revisar",
        "campos": [],
        "acao": "Reconfigure o controle de tração nos novos modos; as tabelas antigas deixaram de existir."
      }
    },
    {
      "id": "backfill-20260819-vvt-zero",
      "tipo": "melhoria",
      "publico": "usuario",
      "titulo": "VVT: controle desligado quando o alvo é perto de zero",
      "descricao": "O controle do comando variável é desativado com o alvo abaixo de 1 grau (liga acima de 3 graus), evitando acúmulo do integrador e travamento do pino de trava em alguns hardwares.",
      "mapa": {
        "impacto": "nenhum",
        "campos": [],
        "acao": ""
      }
    },
    {
      "id": "backfill-20260819-correcoes-combustivel",
      "tipo": "correcao",
      "publico": "usuario",
      "titulo": "Correções no enriquecimento de aceleração e no combustível em malha fechada",
      "descricao": "O enriquecimento de aceleração do TPS não zera mais a desaceleração durante toda a cauda (um toque rápido no pedal ficava rico). Os limiares e filtros de aceleração/desaceleração do TPS agora são lidos da configuração, antes eram constantes fixas. O duplo uso do multiplicador no modo percentual foi corrigido, o canal da correção STFT passou a ler 100% no neutro (lia 99%) e o lambda suavizado passou a ser guardado em unidades de lambda.",
      "mapa": {
        "impacto": "nenhum",
        "campos": [],
        "acao": ""
      }
    },
    {
      "id": "backfill-20260819-correcoes-gerais",
      "tipo": "correcao",
      "publico": "usuario",
      "titulo": "Correções de ignição, partida e comunicação",
      "descricao": "RPM instantâneo parado em zero em gatilho de um dente, rotação mínima de partida zerada entre tentativas, contador próprio por faísca no multispark, estouro de buffer do TunerStudio em leitura com mapa bloqueado, fallback correto do lambda quando o WBO falha, preenchimento ISO-TP com 0xAA e suavização de saídas de boost, corte de DFCO e retardo de detonação.",
      "mapa": {
        "impacto": "nenhum",
        "campos": [],
        "acao": ""
      }
    },
    {
      "id": "backfill-20260819-wideband-aem",
      "tipo": "removido",
      "publico": "usuario",
      "titulo": "Controlador wideband da rusEFI por CAN removido",
      "descricao": "Só o protocolo CAN dos sensores AEM X-Series permanece. O protocolo próprio da rusEFI (com atualização remota e diagnóstico estendido) foi retirado da ECU e do TunerStudio.",
      "mapa": {
        "impacto": "revisar",
        "campos": [],
        "acao": "Se usava um controlador wideband rusEFI por CAN, troque por um sensor AEM ou use a entrada analógica."
      }
    }
